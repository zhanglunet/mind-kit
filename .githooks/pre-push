#!/usr/bin/env bash
# pre-push:推送前跑 pytest;测试未过则拦下这次 push(git push --no-verify 可临时跳过)。
# 由 scripts/install-hooks.sh 经 core.hooksPath 启用。git 以 cwd=仓库根 调用本钩子。
set -uo pipefail

# git 从 stdin 传入待推 ref:"<local_ref> <local_sha> <remote_ref> <remote_sha>"。
# 纯删除推送(所有 local_sha 都是 40 个 0)无需跑测试,直接放行;无 stdin 时照常跑。
only_deletes=1
have_ref=0
while read -r _lref lsha _rref _rsha; do
  have_ref=1
  case "$lsha" in
    0000000000000000000000000000000000000000) : ;;   # 删除该 ref
    *) only_deletes=0 ;;                               # 正常推送(或空行)→ 需跑测试
  esac
done
if [ "$have_ref" -eq 1 ] && [ "$only_deletes" -eq 1 ]; then
  exit 0
fi

# 缺 python3 或 pytest:提示但不拦(避免因环境缺失挡住 push)
# 解析解释器:系统 python3 可能没装 pytest(依赖在 .venv 里),
# 只看 python3 会让钩子**静默放行** —— 推送门禁形同虚设(真机实测)。
# 定位优先按**钩子自己所在的仓库**(.githooks/../),而不是 cwd:git 在 worktree /
# 子模块下调用时 cwd 未必是本仓根,按 cwd 猜会找不到解析库、悄悄退回裸 python3。
HOOK_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
REPO_ROOT="${HOOK_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
if [ -f "$REPO_ROOT/scripts/_pyresolve.sh" ]; then
  . "$REPO_ROOT/scripts/_pyresolve.sh"
  PY="$(mind_python "$REPO_ROOT")"
else
  PY=python3
fi

if ! command -v "$PY" >/dev/null 2>&1 && [ ! -x "$PY" ]; then
  echo "⚠ pre-push:未找到可用 Python($PY),跳过 push 前测试。" >&2
  exit 0
fi
if ! "$PY" -m pytest --version >/dev/null 2>&1; then
  echo "⚠ pre-push:未装 pytest(pip install -r requirements-dev.txt),跳过 push 前测试。" >&2
  exit 0
fi

echo "▶ pre-push:运行 pytest…" >&2
# git 调钩子时会设 GIT_DIR / GIT_INDEX_FILE 等。不清掉,它们会泄漏进测试起的
# **每一个 git 子进程** —— tests/test_vault_sh.py 在 tmp_path 里造临时仓再 `git -C`,
# 子进程却被 GIT_DIR 指回真实仓,于是一片红。这些测试**单独跑全绿、一 push 就红**,
# 门禁从装上那天(2026-07-21)起就没放行过任何一次 push。
# 恒红的门禁等于没有门禁 —— 还更坏,因为它逼所有人养成 --no-verify 的习惯。
env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
    -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
    -u GIT_QUARANTINE_PATH -u GIT_INTERNAL_GETTEXT_SH_SCHEME \
    "$PY" -m pytest -q
code=$?

if [ "$code" -eq 5 ]; then
  exit 0   # pytest 退出码 5 = 未收集到测试,不拦
fi
if [ "$code" -ne 0 ]; then
  echo "✗ pre-push:测试未通过(exit $code),已拦下 push。修好,或 'git push --no-verify' 强推。" >&2
fi
exit "$code"
